{
  "name": "tuberx",
  "productName": "TuberX",
  "version": "0.2.12",
  "description": "TuberX \u2014 paste a link, get the media. A fast, standalone video and audio downloader for Windows and Apple-silicon Macs, powered by a self-updating yt-dlp.",
  "author": "Andre Hall",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:vite": "rm -rf dist dist-electron && vite build",
    "build": "rm -rf dist dist-electron && vite build && electron-builder",
    "build:win": "rm -rf dist dist-electron && vite build && electron-builder --win --x64",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "bun test",
    "tools:fetch": "bun scripts/fetch-tools.ts",
    "build:mac": "rm -rf dist dist-electron && vite build && electron-builder --mac --arm64",
    "build:all": "rm -rf dist dist-electron && vite build && electron-builder --mac --arm64 && electron-builder --win --x64",
    "pot:fetch": "bun scripts/fetch-pot.ts"
  },
  "dependencies": {
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^3.0.6"
  },
  "build": {
    "appId": "dev.drazy.tuberx",
    "productName": "TuberX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      }
    ],
    "protocols": [
      {
        "name": "TuberX",
        "schemes": [
          "tuberx",
          "tuberxlater"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "extraResources": [
        {
          "from": "resources/bin/win32",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/pot/plugins",
          "to": "pot/plugins",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/pot/server",
          "to": "pot/server",
          "filter": [
            "**/*",
            "!node_modules/**"
          ]
        },
        {
          "from": "resources/pot/node_modules-win32",
          "to": "pot/server/node_modules",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "DRAZY",
      "repo": "TuberX"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "resources/bin/darwin",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/pot/plugins",
          "to": "pot/plugins",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/pot/server",
          "to": "pot/server",
          "filter": [
            "**/*",
            "!node_modules/**"
          ]
        },
        {
          "from": "resources/pot/server/node_modules",
          "to": "pot/server/node_modules",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "npmRebuild": false,
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
